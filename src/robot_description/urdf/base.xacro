<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============== base_footprint / base_link ============== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <!-- battery / motor housing ring -->
    <visual>
      <origin xyz="0 0 ${(-0.04 + 0.105) / 2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${base_ring_radius}" length="${base_ring_height}"/>
      </geometry>
      <material name="body_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${(-0.04 + 0.105) / 2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${base_ring_radius}" length="${base_ring_height}"/>
      </geometry>
    </collision>
    <xacro:inertial_cylinder mass="${base_ring_mass}" radius="${base_ring_radius}" length="${base_ring_height}">
      <origin xyz="0 0 ${(-0.04 + 0.105) / 2}" rpy="0 0 0"/>
    </xacro:inertial_cylinder>

    <!-- dark sensor slot that carries the lidar ring, between base and skirt -->
    <visual>
      <origin xyz="0 0 ${(0.105 + 0.165) / 2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${slot_radius}" length="${slot_height}"/>
      </geometry>
      <material name="shell_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${(0.105 + 0.165) / 2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${slot_radius}" length="${slot_height}"/>
      </geometry>
    </collision>
    <xacro:inertial_cylinder mass="0.3" radius="${slot_radius}" length="${slot_height}">
      <origin xyz="0 0 ${(0.105 + 0.165) / 2}" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <!-- ============== drive wheels ============== -->
  <xacro:macro name="drive_wheel" params="prefix reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:inertial_cylinder mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}">
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      </xacro:inertial_cylinder>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 ${reflect * wheel_separation / 2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.1" friction="0.05"/>
    </joint>

    <gazebo reference="${prefix}_wheel_link">
      <collision>
        <surface>
          <friction>
            <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
          </friction>
        </surface>
      </collision>
    </gazebo>
  </xacro:macro>

  <xacro:drive_wheel prefix="left" reflect="1"/>
  <xacro:drive_wheel prefix="right" reflect="-1"/>

  <!-- ============== support casters (fixed, frictionless) ============== -->
  <xacro:macro name="support_caster" params="prefix x_pos">
    <link name="${prefix}_caster_link">
      <visual>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
      </collision>
      <xacro:inertial_sphere mass="${caster_mass}" radius="${caster_radius}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_sphere>
    </link>

    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_caster_link"/>
      <origin xyz="${x_pos} 0 ${caster_radius - wheel_radius}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="${prefix}_caster_link">
      <collision>
        <surface>
          <friction>
            <ode><mu>0.0</mu><mu2>0.0</mu2></ode>
          </friction>
        </surface>
      </collision>
    </gazebo>
  </xacro:macro>

  <xacro:support_caster prefix="front" x_pos="${caster_x}"/>
  <xacro:support_caster prefix="rear" x_pos="${-caster_x}"/>

</robot>
