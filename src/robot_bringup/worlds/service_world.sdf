<?xml version="1.0"?>
<sdf version="1.9">
  <world name="service_world">

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- A few fixed boxes so the LiDAR / Nav2 costmap have something to see -->
    <model name="wall_box_1">
      <static>true</static>
      <pose>3 1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 2.0 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 2.0 1.0</size></box></geometry>
          <material>
            <ambient>0.6 0.3 0.3 1</ambient>
            <diffuse>0.6 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_box_2">
      <static>true</static>
      <pose>3 -1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 2.0 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 2.0 1.0</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.6 1</ambient>
            <diffuse>0.3 0.3 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_cylinder">
      <static>true</static>
      <pose>-2 1 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry>
          <material>
            <ambient>0.3 0.6 0.3 1</ambient>
            <diffuse>0.3 0.6 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Enclosing perimeter (x -5..7, y -4..4) plus one interior partition, so SLAM has structure to map -->
    <model name="room_walls">
      <static>true</static>
      <link name="link">
        <collision name="north"><pose>1 4 0.5 0 0 0</pose><geometry><box><size>12.2 0.2 1.0</size></box></geometry></collision>
        <visual name="north"><pose>1 4 0.5 0 0 0</pose><geometry><box><size>12.2 0.2 1.0</size></box></geometry>
          <material><ambient>0.75 0.75 0.7 1</ambient><diffuse>0.75 0.75 0.7 1</diffuse></material></visual>
        <collision name="south"><pose>1 -4 0.5 0 0 0</pose><geometry><box><size>12.2 0.2 1.0</size></box></geometry></collision>
        <visual name="south"><pose>1 -4 0.5 0 0 0</pose><geometry><box><size>12.2 0.2 1.0</size></box></geometry>
          <material><ambient>0.75 0.75 0.7 1</ambient><diffuse>0.75 0.75 0.7 1</diffuse></material></visual>
        <collision name="west"><pose>-5 0 0.5 0 0 0</pose><geometry><box><size>0.2 8.2 1.0</size></box></geometry></collision>
        <visual name="west"><pose>-5 0 0.5 0 0 0</pose><geometry><box><size>0.2 8.2 1.0</size></box></geometry>
          <material><ambient>0.75 0.75 0.7 1</ambient><diffuse>0.75 0.75 0.7 1</diffuse></material></visual>
        <collision name="east"><pose>7 0 0.5 0 0 0</pose><geometry><box><size>0.2 8.2 1.0</size></box></geometry></collision>
        <visual name="east"><pose>7 0 0.5 0 0 0</pose><geometry><box><size>0.2 8.2 1.0</size></box></geometry>
          <material><ambient>0.75 0.75 0.7 1</ambient><diffuse>0.75 0.75 0.7 1</diffuse></material></visual>
        <collision name="partition"><pose>-3 -2 0.5 0 0 0</pose><geometry><box><size>4.0 0.2 1.0</size></box></geometry></collision>
        <visual name="partition"><pose>-3 -2 0.5 0 0 0</pose><geometry><box><size>4.0 0.2 1.0</size></box></geometry>
          <material><ambient>0.75 0.75 0.7 1</ambient><diffuse>0.75 0.75 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Primary charging dock DOCK_MAIN. Docked robot pose = world/map (0,0,yaw 0); the robot drives
         forward (+x) onto the pad. All geometry is below the lidar plane (z 0.21), so it is invisible
         to /scan, the map and the collision monitor. Terminal face at x=0.30 sits just ahead of the
         0.27 m body front. -->
    <model name="charging_dock_main">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <visual name="pad">
          <pose>0.05 0 0.0015 0 0 0</pose>
          <geometry><box><size>1.0 0.6 0.003</size></box></geometry>
          <material><ambient>0.1 0.4 0.9 1</ambient><diffuse>0.1 0.4 0.9 1</diffuse></material>
        </visual>
        <visual name="arrow_shaft">
          <pose>-0.2 0 0.004 0 0 0</pose>
          <geometry><box><size>0.5 0.06 0.002</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="contact_zone">
          <pose>0 0 0.004 0 0 0</pose>
          <geometry><box><size>0.12 0.10 0.002</size></box></geometry>
          <material><ambient>0.1 0.9 0.2 1</ambient><diffuse>0.1 0.9 0.2 1</diffuse></material>
        </visual>
        <collision name="terminal">
          <pose>0.34 0 0.06 0 0 0</pose>
          <geometry><box><size>0.08 0.5 0.12</size></box></geometry>
        </collision>
        <visual name="terminal">
          <pose>0.34 0 0.06 0 0 0</pose>
          <geometry><box><size>0.08 0.5 0.12</size></box></geometry>
          <material><ambient>0.9 0.7 0.1 1</ambient><diffuse>0.9 0.7 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
